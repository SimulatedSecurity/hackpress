# wp2shell lab — WordPress 7.0.1 (affected; fixed in 7.0.2)
# Authorized local testing only.

WP_PORT=8080
WP_URL=http://localhost:8080

# Official image pin (CVE-2026-63030 / wp2shell affected range: 7.0.0–7.0.1)
WORDPRESS_IMAGE=wordpress:7.0.1-apache
WORDPRESS_CLI_IMAGE=wordpress:cli-php8.3

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpass

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@lab.local
WP_TITLE=wp2shell-lab
